"""
Lint JavaScript and TypeScript projects in a workspace with ESLint.
"""
type Eslint {
  """
  The base image to use.
  """
  baseImageAddress: String!

  """
  The package manager to use: npm, pnpm, yarn or bun. Empty detects it.
  """
  packageManager: String!

  """
  Extra arguments for the dependency install command.
  """
  installFlags: [String!]!

  """
  Environment variables for ESLint, as KEY=VALUE.
  """
  environment: [String!]!

  new(
    """
    Container image with Node.js.
    """
    baseImageAddress: String! = "node:25-alpine",
    """
    Package manager: npm, pnpm, yarn or bun. Empty detects it from the
    packageManager field of package.json, then from the lockfile.
    """
    packageManager: String! = "",
    """
    Extra arguments for the dependency install command, e.g. ["--ignore-scripts"].
    """
    installFlags: [String!]! = [],
    """
    Environment variables for ESLint, as KEY=VALUE.
    """
    environment: [String!]! = [],
  ) {
    self.baseImageAddress = baseImageAddress
    self.packageManager = packageManager
    self.installFlags = installFlags
    self.environment = environment
    self
  }

  """
  ESLint projects at or below the working directory, keyed by config root.
  """
  projects(ws: Workspace!): EslintProjects! {
    # One scan of the whole workspace serves discovery, the global-ignores
    # pruning and every project's list of nested projects, so none of them
    # depends on where dagger runs.
    let roots = sorted(configRoots(ws, ".").uniq)
    let projects = roots.filter { root => ignored(ws, roots, root) == false }
    let cwd = cwdPath(ws)
    let below = projects.filter { project => isBelow(project, cwd) }
    # Inside a project's subdirectory (or a directory it ignores), the
    # enclosing project is selected too.
    let empty: [String!]! = []
    let enclosing = if (below.any { project => project == cwd }) {
      empty
    } else {
      let found = deepest(
        projects.filter { project => project != cwd and isBelow(cwd, project) },
      )
      if (found == null) { empty } else { [found ?? "."] }
    }
    EslintProjects(paths: sorted(enclosing + below), roots: roots, tool: self)
  }

  """
  Flat config file names.
  """
  let flatConfigNames: [String!]! {
    [
      "eslint.config.js",
      "eslint.config.mjs",
      "eslint.config.cjs",
      "eslint.config.ts",
      "eslint.config.mts",
      "eslint.config.cts",
    ]
  }

  """
  File names that mark a directory as an ESLint project: flat config files
  and legacy .eslintrc files.
  """
  let configNames: [String!]! {
    flatConfigNames + [
      ".eslintrc",
      ".eslintrc.js",
      ".eslintrc.cjs",
      ".eslintrc.json",
      ".eslintrc.yaml",
      ".eslintrc.yml",
    ]
  }

  """
  Workspace-root-relative directories holding an ESLint config at or below
  start, plus the nearest enclosing one when start holds none.
  """
  let configRoots(ws: Workspace!, start: String!): [String!]! {
    ws
      .findRoots(
        markers: configNames,
        start: absolutePath(start),
        exclude: ["**/node_modules"],
      )
      .map { dir => workspaceRootPath(ws, dir) }
  }

  """
  Whether a flat config in another discovered project above root ignores it
  through its global ignores.
  """
  let ignored(ws: Workspace!, roots: [String!]!, root: String!): Boolean! {
    let parent = parentRoot(roots, root)
    if (parent == null) {
      false
    } else {
      let dir = parent ?? "."
      ignored(ws, roots, dir) or ignores(ws, dir, relativePath(root, dir))
    }
  }

  """
  The nearest config root strictly above root, or null.
  """
  let parentRoot(roots: [String!]!, root: String!): String {
    deepest(roots.filter { dir => dir != root and isBelow(root, dir) })
  }

  """
  Whether the global ignores of the flat config in dir cover the
  dir-relative directory rel. Later patterns win, so "!" re-includes.
  """
  let ignores(ws: Workspace!, dir: String!, rel: String!): Boolean! {
    matchesIgnores(globalIgnores(ws, dir), rel)
  }

  """
  Whether ignore patterns, relative to a config's directory, cover the
  path rel below it, or a directory holding it. Later patterns win, so "!"
  re-includes.
  """
  let matchesIgnores(patterns: [String!]!, rel: String!): Boolean! {
    if (patterns.length == 0) {
      false
    } else {
      # Ignoring a directory ignores everything below it, including the
      # nested config file itself.
      let empty: [String!]! = []
      let prefixes = rel.split("/").reduce(empty) { acc, segment =>
        acc + [if (acc.length == 0) { segment } else { acc.takeLast(1).join("") + "/" + segment }]
      }
      let candidates = prefixes + prefixes.map { p => p + "/" }
      patterns.reduce(false) { ignored, pattern =>
        let negated = pattern.hasPrefix("!")
        let re = globRegex(pattern.trimPrefix("!"))
        if (candidates.any { c => c.containsMatch(`${re}`) }) { negated == false } else { ignored }
      }
    }
  }

  """
  The string patterns of the global ignores in the flat config in dir: an
  object holding only ignores (and a name), or a globalIgnores([...]) call.
  Patterns built at runtime are not seen.
  """
  let globalIgnores(ws: Workspace!, dir: String!): [String!]! {
    let file = configFile(ws, dir, flatConfigNames)
    let empty: [String!]! = []
    # An unreadable config ignores nothing here: its own project fails alone,
    # naming it, rather than discovery failing for the whole workspace.
    if (file == null or readFailure(ws, file ?? "") != null) {
      empty
    } else {
      let text = ws.file(file ?? "").contents
      let arrays = text.matchAll(
        `\{\s*(?:name\s*:\s*(?:'[^']*'|"[^"]*")\s*,\s*)?ignores\s*:\s*\[([^\]]*)\]\s*,?\s*\}`,
      ) + text.matchAll(`globalIgnores\(\s*\[([^\]]*)\]`)
      literals(arrays.map { array => array.captures.join("") })
    }
  }

  """
  The string literals in pieces of config text.
  """
  let literals(texts: [String!]!): [String!]! {
    let empty: [String!]! = []
    texts.reduce(empty) { acc, text =>
      acc + text.matchAll(`'([^']*)'|"([^"]*)"`).map { literal => literal.captures.join("") }
    }
  }

  """
  The workspace-absolute path of the first of names present in dir, in
  that order, or null.
  """
  let configFile(ws: Workspace!, dir: String!, names: [String!]!): String {
    let prefix = if (dir == ".") { "" } else { dir + "/" }
    let present = (ws.glob(prefix + "eslint.config.*") + ws.glob(prefix + ".eslintrc*")).map { file =>
      file.trimPrefix("/").trimPrefix("./")
    }
    let found = names.filter { name => present.contains(prefix + name) }
    if (found.length == 0) { null } else { "/" + prefix + found[0]! }
  }

  """
  Why the workspace-absolute file cannot be read, naming it, or null.
  """
  let readFailure(ws: Workspace!, file: String!): String {
    {
      ws.file(file).contents
      null
    } rescue {
      err: Error => file.trimPrefix("/") + ": cannot read the ESLint config: " + err.message
    }
  }

  """
  The pinned image the report indexer runs in, whatever the base: it needs
  only Node, and the base need not have it at a version the indexer knows.
  """
  let indexerImage: String! = "node:24.11.1-alpine3.22"

  """
  Legacy config file names, in the order ESLint 8 prefers them.
  """
  let legacyConfigNames: [String!]! {
    [".eslintrc.js", ".eslintrc.cjs", ".eslintrc.yaml", ".eslintrc.yml", ".eslintrc.json", ".eslintrc"]
  }

  """
  A regular expression for an ESLint (minimatch) glob, relative to the
  config's directory.
  """
  let globRegex(glob: String!): String! {
    let body = glob
      .trimPrefix("./")
      .trimPrefix("/")
      .rewriteMatches(`\*\*/|/\*\*$|\*\*|\*|\?|\{|\}|,|[.+^$()|\[\]\\]`) { match =>
        let s = match.string
        if (s == "**/") {
          "(?:.*/)?"
        } else if (s == "/**") {
          "(?:/.*)?"
        } else if (s == "**") {
          ".*"
        } else if (s == "*") {
          "[^/]*"
        } else if (s == "?") {
          "[^/]"
        } else if (s == "{") {
          "(?:"
        } else if (s == "}") {
          ")"
        } else if (s == ",") {
          "|"
        } else {
          "\\" + s
        }
      }
    "^" + body + "$"
  }

  let project(path: String!, roots: [String!]!): EslintProject! {
    EslintProject(path: path, roots: roots, tool: self)
  }

  """
  Workspace-root-relative path of the caller's location.
  """
  let cwdPath(ws: Workspace!): String! {
    workspaceRootPath(ws, ".")
  }

  """
  Resolve a path relative to the caller's location, as findRoots returns
  them, into a workspace-root-relative one, collapsing any leading "..".
  """
  let workspaceRootPath(ws: Workspace!, cwdRelPath: String!): String! {
    let segments = cwdRelPath.split("/").filter { s => s != "" and s != "." }
    let up = segments.filter { s => s == ".." }.length
    let down = segments.filter { s => s != ".." }
    let resolved = ws.cwd.split("/").filter { s => s != "" }.dropLast(up) + down
    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  """
  Where a workspace-root-relative path is mounted in the ESLint container.
  """
  let containerPath(path: String!): String! {
    if (path == ".") { "/src" } else { "/src/" + path }
  }

  """
  The workspace-absolute spelling of a workspace-root-relative path.
  """
  let absolutePath(path: String!): String! {
    if (path == ".") { "/" } else { "/" + path }
  }

  """
  Whether path is dir or below it.
  """
  let isBelow(path: String!, dir: String!): Boolean! {
    dir == "." or path == dir or path.hasPrefix(dir + "/")
  }

  """
  path relative to dir, which holds it.
  """
  let relativePath(path: String!, dir: String!): String! {
    if (path == dir) { "." } else if (dir == ".") { path } else {
      path.trimPrefix(dir + "/")
    }
  }

  """
  rel resolved against dir, collapsing "." and "..". A result starting with
  ".." leaves dir's root.
  """
  let joinPath(dir: String!, rel: String!): String! {
    let prefix = if (dir == ".") { "" } else { dir + "/" }
    let segments = (prefix + rel).split("/")
    let empty: [String!]! = []
    let resolved = segments.reduce(empty) { acc, segment =>
      if (segment == "" or segment == ".") {
        acc
      } else if (segment == ".." and acc.length > 0 and acc.takeLast(1).join("") != "..") {
        acc.dropLast(1)
      } else {
        acc + [segment]
      }
    }
    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  """
  The workspace-root-relative directory of a workspace-absolute file path.
  """
  let dirOf(file: String!): String! {
    let dir = file.trimPrefix("/").split("/").dropLast(1).join("/")
    if (dir == "") { "." } else { dir }
  }

  let depth(dir: String!): Int! {
    if (dir == ".") { 0 } else { dir.split("/").length }
  }

  """
  The deepest of the given directories.
  """
  let deepest(dirs: [String!]!): String {
    let none: String = null
    dirs.reduce(none) { best, dir =>
      if (best == null) { dir } else if (depth(dir) > depth(best ?? ".")) { dir } else { best }
    }
  }

  """
  items in byte order. A merge sort: file lists can be long.
  """
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  """
  Merges two byte-ordered lists into one.
  """
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
ESLint projects in a workspace, keyed by config root.
"""
type EslintProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  """
  Every ESLint config root in the workspace, projects or not.
  """
  let roots: [String!]!

  let tool: Eslint!

  """
  The ESLint project rooted at path.
  """
  project(path: String!): EslintProject! @get {
    tool.project(path, roots)
  }

  """
  Lint the projects in this collection, each with one ESLint run over its
  whole tree, and report every failing project. A plain helper, not a check:
  dagger check runs one check per file instead.
  """
  lint(ws: Workspace!): Void {
    # A selection over a list evaluates its elements concurrently, so every
    # project is linted in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: lintFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "ESLint failed in " + toString(failures.length) + " of " + toString(paths.length)
        + " projects:\n" + failures.map { result => "- " + (result.failure ?? "") }.join("\n")
    }
    null
  }
}

"""
An ESLint project rooted at the directory holding its config.
"""
type EslintProject {
  """
  Project root, relative to the workspace root.
  """
  path: String!

  """
  Every ESLint config root in the workspace.
  """
  let roots: [String!]!

  let tool: Eslint!

  """
  Files in this project that ESLint lints, keyed by workspace path.
  """
  files(ws: Workspace!): EslintFiles! {
    # A project whose discovery fails has one file, its config, whose check
    # reports why; other projects are unaffected.
    let found = if (discoveryFailure(ws) == null) {
      tool.sorted(lintableFiles(ws))
    } else {
      [tool.joinPath(".", configPath(ws).trimPrefix("/"))]
    }
    EslintFiles(paths: found, project: tool.project(path, roots))
  }

  """
  Lint this whole project with one ESLint run, reporting every failing file.
  A plain helper, not a check: dagger check runs one check per file instead.
  """
  lint(ws: Workspace!): Void {
    let failure = lintFailure(ws)
    if (failure != null) {
      raise failure ?? ""
    }
    null
  }

  """
  Fix linting issues in this project. Problems ESLint cannot fix are left for
  lint to report.
  """
  fix(ws: Workspace!): Changeset! {
    let failure = installFailure(ws)
    if (failure != null) {
      raise path + ": " + (failure ?? "")
    }
    let ready = runtime(ws)
    let fixed = ready.withExec(eslint(ws) + ["--fix"], expect: ReturnType.ANY)
    # ESLint exits 1 when problems it cannot fix remain, and 2 when it could
    # not run at all.
    if (fixed.exitCode > 1) {
      raise path + ": " + (stepFailure("eslint --fix failed", "", fixed, 30) ?? "")
    }
    # The CLI applies a changeset from the caller's location, so root it
    # there. A project enclosing the caller contributes only the part below
    # it, which is all a changeset rooted there can hold.
    let cwd = tool.cwdPath(ws)
    let scope = if (tool.isBelow(path, cwd)) { path } else { cwd }
    let at = tool.relativePath(scope, cwd)
    # Diff against the same container before the fix so dependency installs
    # (lockfiles, node_modules) never reach the changeset.
    let after = directory.withDirectory(
      at,
      fixed.directory(tool.containerPath(scope)),
      exclude: ["**/node_modules"],
    )
    let before = directory.withDirectory(
      at,
      ready.directory(tool.containerPath(scope)),
      exclude: ["**/node_modules"],
    )
    after.changes(before)
  }

  """
  Why linting this whole project failed, naming the failing step or files,
  or null when it passes.
  """
  let lintFailure(ws: Workspace!): String {
    let summary = lintFiles(ws, files(ws).paths, true).summary
    if (summary == "") { null } else { summary }
  }

  """
  One ESLint run and report shared by every selected file check in this
  project, with a bounded result for each file.

  The command depends only on the selection, never on which check asks, so
  the engine runs it once for all of them. A whole selection lints the
  project as ESLint walks it; a narrowed one names the selected files,
  sorted. ESLint runs with any exit code and its JSON report goes to a file,
  so no failure is raised here: an indexer, shared too, attributes the report
  to the selected files.
  """
  let lintFiles(ws: Workspace!, keys: [String!]!, whole: Boolean!): EslintResults! {
    # Keys arrive in discovery order; a narrowed run sorts them anyway, so
    # its command never depends on the order a selection was made in.
    let selected = if (whole) { keys } else { tool.sorted(keys.uniq) }
    let discovery = discoveryFailure(ws)
    let install = if (discovery == null) { installFailure(ws) } else { null }
    if (discovery != null) {
      EslintResults(paths: selected, failure: path + ": " + (discovery ?? ""), results: directory)
    } else if (install != null) {
      EslintResults(paths: selected, failure: path + ": " + (install ?? ""), results: directory)
    } else {
      let targets = if (whole) { wholeTargets } else {
        selected.map { file => tool.relativePath(file, path) }
      }
      let executed = runtime(ws).withExec(
        ["dagger-eslint", "--format", "json"] + targets,
        expect: ReturnType.ANY,
        redirectStdout: "/dagger-eslint-report.json",
        redirectStderr: "/dagger-eslint-stderr.log",
      )
      let indexed = container
        .from(tool.indexerImage)
        .withFile("/eslint/report.cjs", currentModule.source.file("helpers/eslint-report.cjs"))
        .withFile("/eslint/report.json", executed.file("/dagger-eslint-report.json"))
        .withFile("/eslint/stderr.log", executed.file("/dagger-eslint-stderr.log"))
        .withNewFile(
          "/eslint/selection.json",
          JSON.encode(
            selected.map { file => {{key: file, path: tool.containerPath(file)}} },
          ),
        )
        .withExec([
          "node", "/eslint/report.cjs",
          "--report", "/eslint/report.json",
          "--stderr", "/eslint/stderr.log",
          "--selection", "/eslint/selection.json",
          "--exit-code", toString(executed.exitCode),
          "--project", path,
          "--root", "/src",
          "--output", "/eslint/results",
        ])
      EslintResults(paths: selected, failure: "", results: indexed.directory("/eslint/results"))
    }
  }

  """
  Files ESLint lints in this project, workspace-root-relative. Found from
  file names and config text only, so listing runs neither ESLint nor Node:

  - the extensions ESLint lints by default (.js, .mjs and .cjs with a flat
    config, .js with a legacy one), and the files that literal `files`
    patterns in the config match (legacy: in its overrides);
  - TypeScript, Vue, Svelte and Astro files when the config names their
    ESLint plugin, unless a flat config's literal `files` pattern names that
    extension;
  - minus .gitignored files, node_modules, nested projects, the config's
    literal global ignores (legacy: .eslintignore and ignorePatterns) and,
    with a legacy config, dotfiles.

  ESLint has the last word: a file it does not lint fails its check, saying
  so, and errors in a file not listed here fail the project's checks.
  """
  let lintableFiles(ws: Workspace!): [String!]! {
    let flat = tool.configFile(ws, path, tool.flatConfigNames) != null
    let file = configPath(ws)
    let text = ws.file(file).contents
    let patterns = filePatterns(text, flat)
    let patternExtensions = extensionsOf(patterns)
    let defaults = if (flat) { ["js", "mjs", "cjs"] } else { ["js"] }
    # A flat config that names an extension in its own files patterns may
    # scope the plugin's preset to them; legacy presets bring overrides that
    # apply whatever the config's own say.
    let presets = presetExtensions(text).filter { ext =>
      flat == false or patternExtensions.contains(ext) == false
    }
    let extensions = (defaults + presets + patternExtensions).uniq
    let regexes = patterns.map { p => tool.globRegex(p) }
    let ignores = if (flat) {
      tool.globalIgnores(ws, path)
    } else {
      legacyIgnores(ws, text)
    }
    let tree = ws.directory(
      tool.absolutePath(path),
      include: extensions.map { ext => "**/*." + ext },
      exclude: ["**/node_modules", ".git"] + nestedDirs,
      gitignore: true,
    )
    let empty: [String!]! = []
    extensions
      .reduce(empty) { acc, ext => acc + tree.glob("**/*." + ext) }
      .map { found => found.trimPrefix("/").trimPrefix("./").trimSuffix("/") }
      .uniq
      .filter { rel =>
        let ext = rel.split(".").takeLast(1).join("")
        let matched = defaults.contains(ext)
          or presets.contains(ext)
          or regexes.any { re => rel.containsMatch(`${re}`) }
        let hidden = flat == false
          and rel.split("/").any { segment => segment.hasPrefix(".") }
          and rel.split("/").takeLast(1).join("") != ".eslintrc.js"
        matched and hidden == false and tool.matchesIgnores(ignores, rel) == false
      }
      .map { rel => tool.joinPath(path, rel) }
  }

  """
  The workspace-absolute path of this project's config: its flat config,
  else its legacy one.
  """
  let configPath(ws: Workspace!): String! {
    tool.configFile(ws, path, tool.flatConfigNames)
      ?? tool.configFile(ws, path, tool.legacyConfigNames)
        ?? tool.absolutePath(path)
  }

  """
  Why this project's files cannot be discovered, naming the file, or null:
  its config, its .eslintignore or its tree cannot be read.
  """
  let discoveryFailure(ws: Workspace!): String {
    let config = tool.readFailure(ws, configPath(ws))
    if (config != null) {
      config
    } else {
      {
        lintableFiles(ws)
        null
      } rescue {
        err: Error => "cannot list the files of " + path + ": " + err.message
      }
    }
  }

  """
  Directories of the projects nested in this one, relative to it.
  """
  let nestedDirs: [String!]! {
    roots
      .filter { dir => dir != path and tool.isBelow(dir, path) }
      .map { dir => tool.relativePath(dir, path) }
  }

  """
  The literal patterns of the `files` keys in config text that make ESLint
  lint a file: negated patterns and ones ending in * do not. A legacy
  pattern without a slash matches a base name at any depth.
  """
  let filePatterns(text: String!, flat: Boolean!): [String!]! {
    let values = text.matchAll(`(?:^|[^A-Za-z0-9_$])["']?files["']?\s*:\s*(\[[^\]]*\]|'[^']*'|"[^"]*")`)
    tool
      .literals(values.map { value => value.captures.join("") })
      .filter { p => p != "" and p.hasPrefix("!") == false and p.hasSuffix("*") == false }
      .map { p =>
        if (flat == false and p.trimPrefix("./").contains("/") == false) { "**/" + p } else { p }
      }
      .uniq
  }

  """
  The file extensions that patterns end in, braces expanded.
  """
  let extensionsOf(patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns
      .reduce(empty) { acc, p =>
        acc + p.matchAll(`\.([A-Za-z0-9]+)$|\.\{([A-Za-z0-9,]+)\}$`).reduce(empty) { exts, m =>
          exts + m.captures.join("").split(",")
        }
      }
      .filter { ext => ext != "" }
      .uniq
  }

  """
  Extensions the ESLint plugins named in config text lint through their
  presets, which set `files` patterns the config text does not show.
  """
  let presetExtensions(text: String!): [String!]! {
    let empty: [String!]! = []
    let ts = if (text.containsMatch(`typescript-eslint|eslint-config-typescript`)) {
      ["ts", "tsx", "mts", "cts"]
    } else { empty }
    let vue = if (text.containsMatch(`eslint-plugin-vue|plugin:vue/`)) { ["vue"] } else { empty }
    let svelte = if (text.containsMatch(`eslint-plugin-svelte|plugin:svelte/`)) { ["svelte"] } else { empty }
    let astro = if (text.containsMatch(`eslint-plugin-astro|plugin:astro/`)) { ["astro"] } else { empty }
    ts + vue + svelte + astro
  }

  """
  A legacy project's ignore patterns, as globs relative to it: its
  .eslintignore and the literal ignorePatterns of its config, read with
  gitignore rules.
  """
  let legacyIgnores(ws: Workspace!, text: String!): [String!]! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    let empty: [String!]! = []
    let ignoreFile = if (hasFile(ws, prefix + ".eslintignore")) {
      ws.file("/" + prefix + ".eslintignore").contents.split("\n").map { line => line.trimSpace }
    } else { empty }
    let configured = tool.literals(
      text.matchAll(`["']?ignorePatterns["']?\s*:\s*\[([^\]]*)\]`).map { m => m.captures.join("") },
    )
    (ignoreFile + configured)
      .filter { line => line != "" and line.hasPrefix("#") == false }
      .map { line =>
        let negated = line.hasPrefix("!")
        let body = line.trimPrefix("!")
        let anchored = body.hasPrefix("/") or body.trimSuffix("/").contains("/")
        let glob = if (anchored) { body.trimPrefix("/") } else { "**/" + body }
        (if (negated) { "!" } else { "" }) + glob
      }
  }

  """
  Why installing this project's dependencies failed, or null.
  """
  let installFailure(ws: Workspace!): String {
    let root = installRoot(ws)
    if (root == null) {
      null
    } else {
      let dir = root ?? "."
      let pm = packageManagerFor(ws, dir)
      let setup = {
        withPackageManager(pm).sync
        null
      } rescue {
        err: Error => "could not set up " + pm + ": " + err.message
      }
      if (setup != null) {
        setup
      } else {
        stepFailure(
          "install failed",
          installCommand(ws, dir).join(" "),
          installed(ws, dir),
          15,
        )
      }
    }
  }

  """
  A failure message for an exec that ran with any exit code, or null when it
  succeeded: the step, its exit code and the last lines of its output.
  """
  let stepFailure(step: String!, command: String!, ran: Container!, lines: Int!): String {
    let code = ran.exitCode
    if (code == 0) {
      null
    } else if (code == 127 and command == "") {
      # The ESLint runner explains itself when the project lacks ESLint.
      ran.stderr.trimSpace
    } else {
      let output = (ran.stderr + "\n" + ran.stdout).trimSpace.split("\n").takeLast(lines).join("\n")
      let detail = if (command == "") { "" } else { command + ", " }
      let tail = if (output == "") { "" } else { ":\n" + output }
      step + " (" + detail + "exit " + toString(code) + ")" + tail
    }
  }

  """
  The ESLint command for this whole project.
  """
  let eslint(ws: Workspace!): [String!]! {
    ["dagger-eslint"] + wholeTargets
  }

  """
  ESLint arguments that lint this whole project. Nested projects are linted
  on their own, with their own config, so they are ignored here.
  """
  let wholeTargets: [String!]! {
    let empty: [String!]! = []
    let ignores = nestedDirs.reduce(empty) { args, dir => args + ["--ignore-pattern", dir + "/**"] }
    # A project whose files all belong to nested projects has nothing left to
    # lint, which ESLint otherwise reports as an error.
    let unmatched = if (nestedDirs.length > 0) { ["--no-error-on-unmatched-pattern"] } else { empty }
    ["."] + ignores + unmatched
  }

  """
  Runs the project's own ESLint: the nearest node_modules/.bin/eslint up to
  the install root, or yarn's under Plug'n'Play, and says how to fix it when
  there is none. Without an install root, npx fetches ESLint.
  """
  let runner: String! {
    ```
    #!/bin/sh
    if [ -z "$ESLINT_INSTALL_ROOT" ]; then
      echo "+ npx --yes eslint $*" >&2
      exec npx --yes eslint "$@"
    fi
    d=$PWD
    while :; do
      if [ -x "$d/node_modules/.bin/eslint" ]; then
        echo "+ \${d#/src/}/node_modules/.bin/eslint $*" >&2
        exec "$d/node_modules/.bin/eslint" "$@"
      fi
      if [ "$d" = "$ESLINT_INSTALL_ROOT" ] || [ "$d" = / ]; then break; fi
      d=$(dirname "$d")
    done
    if [ -f "$ESLINT_INSTALL_ROOT/.pnp.cjs" ]; then
      echo "+ yarn eslint $*" >&2
      exec yarn eslint "$@"
    fi
    manifest="\${ESLINT_INSTALL_ROOT#/src/}/package.json"
    if [ "$PWD" = "$ESLINT_INSTALL_ROOT" ]; then
      echo "eslint is not installed: add it to the devDependencies of $manifest" >&2
    else
      echo "eslint is not installed: add it to the devDependencies of $manifest, or of a package.json between it and the project" >&2
    fi
    exit 127
    ```
  }

  """
  Where dependencies are installed: the nearest workspace root at or above
  this project (pnpm-workspace.yaml, or a package.json with "workspaces"),
  else the nearest directory with a lockfile, else the nearest package.json.
  Null when there is no package.json at or above the project.
  """
  let installRoot(ws: Workspace!): String {
    let from = tool.absolutePath(path)
    let pkg = ws.findUp(name: "package.json", from: from)
    if (pkg == null) {
      null
    } else {
      let pkgDir = tool.dirOf(pkg ?? "")
      let empty: [String!]! = []
      let pnpmWorkspace = ws.findUp(name: "pnpm-workspace.yaml", from: from)
      let pnpmRoots = if (pnpmWorkspace == null) { empty } else { [tool.dirOf(pnpmWorkspace ?? "")] }
      let workspaceRoots = workspacesPackage(ws, pkgDir) + pnpmRoots
      let lockDirs = lockfiles.reduce(empty) { dirs, name =>
        let found = ws.findUp(name: name, from: from)
        if (found == null) { dirs } else { dirs + [tool.dirOf(found ?? "")] }
      }
      tool.deepest(workspaceRoots) ?? tool.deepest(lockDirs) ?? pkgDir
    }
  }

  """
  The nearest directory at or above dir whose package.json declares
  "workspaces", as a one-element list, or empty.
  """
  let workspacesPackage(ws: Workspace!, dir: String!): [String!]! {
    let prefix = if (dir == ".") { "" } else { dir + "/" }
    let declares = ws.file("/" + prefix + "package.json").contents.containsMatch(`"workspaces"\s*:`)
    let empty: [String!]! = []
    if (declares) {
      [dir]
    } else if (dir == ".") {
      empty
    } else {
      let parent = ws.findUp(name: "package.json", from: tool.absolutePath(
        tool.dirOf("/" + dir),
      ))
      if (parent == null) { empty } else {
        workspacesPackage(
          ws,
          tool.dirOf(parent ?? ""),
        )
      }
    }
  }

  let lockfiles: [String!]! {
    ["pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "package-lock.json", "npm-shrinkwrap.json"]
  }

  """
  The package manager for the install root: the setting, else the
  packageManager field of its package.json, else its lockfile, else npm.
  """
  let packageManagerFor(ws: Workspace!, root: String!): String! {
    let prefix = if (root == ".") { "" } else { root + "/" }
    let declared = ws
      .file("/" + prefix + "package.json")
      .contents
      .matchAll(`"packageManager"\s*:\s*"(npm|pnpm|yarn|bun)@`)
      .map { m => m.captures.join("") }
    if (tool.packageManager != "") {
      tool.packageManager
    } else if (declared.length > 0) {
      declared.takeLast(1).join("")
    } else if (hasFile(ws, prefix + "pnpm-lock.yaml")) {
      "pnpm"
    } else if (hasFile(ws, prefix + "yarn.lock")) {
      "yarn"
    } else if (hasFile(ws, prefix + "bun.lock") or hasFile(ws, prefix + "bun.lockb")) {
      "bun"
    } else {
      "npm"
    }
  }

  let hasFile(ws: Workspace!, file: String!): Boolean! {
    ws.glob(file).length > 0
  }

  let installCommand(ws: Workspace!, root: String!): [String!]! {
    let pm = packageManagerFor(ws, root)
    # pnpm 12 ignores npm_config_store_dir, so name the cached store on the
    # command line.
    let store = if (pm == "pnpm") { ["--store-dir", "/root/.pnpm-store"] } else { [] }
    [pm, "install"] + store + tool.installFlags
  }

  """
  Node container with every package manager's cache on a volume, and browser
  downloads and git hooks switched off: ESLint needs none of them.
  """
  let base: Container! {
    container
      .from(tool.baseImageAddress)
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withEnvVariable("npm_config_cache", "/root/.npm")
      # Concurrent yarn 1 installs corrupt a shared cache.
      .withMountedCache("/root/.yarn-cache", cacheVolume("yarn-cache"), sharing: CacheSharingMode.LOCKED)
      .withEnvVariable("YARN_CACHE_FOLDER", "/root/.yarn-cache")
      .withMountedCache("/root/.bun-cache", cacheVolume("bun-cache"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun-cache")
      .withMountedCache("/root/.corepack", cacheVolume("corepack"))
      .withEnvVariable("COREPACK_HOME", "/root/.corepack")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD", "1")
      .withEnvVariable("PUPPETEER_SKIP_DOWNLOAD", "1")
      .withEnvVariable("CYPRESS_INSTALL_BINARY", "0")
      .withEnvVariable("HUSKY", "0")
      .withEnvVariable("SKIP_INSTALL_SIMPLE_GIT_HOOKS", "1")
  }

  """
  base with the package manager available. pnpm and yarn come from
  corepack, so the packageManager version in package.json is honoured.
  """
  let withPackageManager(pm: String!): Container! {
    if (pm == "pnpm" or pm == "yarn") {
      # Images from node 25 on no longer ship corepack, and --force replaces
      # the yarn they still ship.
      let ctr = if (pm == "pnpm") {
        base
          .withMountedCache("/root/.pnpm-store", cacheVolume("pnpm-store"))
      } else {
        base
      }
      ctr.withExec([
        "sh",
        "-c",
        "command -v corepack >/dev/null 2>&1 || npm install -g --force corepack; corepack enable",
      ])
    } else if (pm == "bun") {
      base.withExec(["sh", "-c", "command -v bun >/dev/null 2>&1 || npm install -g bun"])
    } else {
      base
    }
  }

  """
  Files the install reads, under the install root. Only these are mounted
  for the install, so editing source does not re-run it.
  """
  let installInputs(ws: Workspace!, root: String!): Directory! {
    let manifests = ws.directory(
      tool.absolutePath(root),
      include: ["**/package.json"],
      exclude: ["**/node_modules"],
    )
    let local = localDependencies(manifests)
    # pnpm copies injected workspace packages too; rather than resolve their
    # names, install from the full source. So does a local dependency outside
    # the install root.
    let injected = manifests
      .search(pattern: `"injected"\s*:\s*true`, globs: ["**/package.json"], filesOnly: true).{{filePath}}
      .length > 0
    let outside = local.any { dir => dir == ".." or dir.hasPrefix("../") or dir.hasPrefix("/") }
    if (injected or outside) {
      ws.directory(tool.absolutePath(root), exclude: ["**/node_modules"], gitignore: true)
    } else {
      let empty: [String!]! = []
      ws.directory(
        tool.absolutePath(root),
        include: installFiles + local.reduce(empty) { acc, dir => acc + [dir, dir + "/**"] },
        exclude: ["**/node_modules"],
      )
    }
  }

  """
  Files every install reads, relative to the install root.
  """
  let installFiles: [String!]! {
    [
      "**/package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".pnpmfile.cjs",
      "yarn.lock",
      "bun.lock",
      "bun.lockb",
      "bunfig.toml",
      "**/.npmrc",
      ".yarnrc",
      ".yarnrc.yml",
      ".yarn/releases/**",
      ".yarn/plugins/**",
      ".yarn/patches/**",
      "patches/**",
    ]
  }

  """
  Paths, relative to the install root, of the local directories and tarballs
  that package.json files depend on through file:, link: or portal: specs
  (dependencies of any kind, overrides and resolutions). Package managers
  copy them at install time, so the install needs their contents.
  """
  let localDependencies(manifests: Directory!): [String!]! {
    let empty: [String!]! = []
    let hits = manifests
      .search(pattern: `"(file|link|portal):[^"]+"`, globs: ["**/package.json"]).{{filePath, matchedLines}}
    hits
      .reduce(empty) { acc, hit =>
        let file = hit.filePath.trimPrefix("./").trimPrefix("/")
        let dir = tool.dirOf("/" + file)
        acc + hit.matchedLines.matchAll(`"(?:file|link|portal):([^"]+)"`).map { m =>
          let spec = m.captures.join("")
          if (spec.hasPrefix("/")) { spec } else { tool.joinPath(dir, spec) }
        }
      }
      .uniq
  }

  """
  The dependency install, run with any exit code so its failure can be
  reported as such.
  """
  let installed(ws: Workspace!, root: String!): Container! {
    let dir = tool.containerPath(root)
    withPackageManager(packageManagerFor(ws, root))
      .withDirectory(dir, installInputs(ws, root))
      .withWorkdir(dir)
      .withExec(installCommand(ws, root), expect: ReturnType.ANY)
  }

  """
  Container ready to run ESLint in this project. With an install root, its
  dependencies are installed and its tree is mounted at /src/<root>; without
  one, the whole workspace is mounted and npx fetches ESLint.
  """
  let runtime(ws: Workspace!): Container! {
    let root = installRoot(ws)
    let source = if (root == null) {
      base.withDirectory(
        "/src",
        ws.directory("/", exclude: ["**/node_modules"], gitignore: true),
      )
    } else {
      let dir = root ?? "."
      installed(ws, dir)
        .withDirectory(
          tool.containerPath(dir),
          ws.directory(tool.absolutePath(dir), exclude: ["**/node_modules"], gitignore: true),
        )
        .withEnvVariable("ESLINT_INSTALL_ROOT", tool.containerPath(dir))
    }
    let configured = tool.environment.reduce(source) { acc, pair =>
      let key = pair.replaceMatches(`(?s)=.*$`, with: "")
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
    # Plain output, so reports read cleanly in error messages.
    configured
      .withEnvVariable("NO_COLOR", "1")
      .withNewFile("/usr/local/bin/dagger-eslint", runner, permissions: 493)
      .withWorkdir(tool.containerPath(path))
  }
}

"""
Files ESLint lints in one project, keyed by workspace path.
"""
type EslintFiles @collection {
  """
  File paths, relative to the workspace root.
  """
  paths: [String!]! @keys

  """
  Files selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed files from this collection. Without a
  delta (a direct call, outside dagger check), it counts as narrowed.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  let project: EslintProject!

  """
  The file at path.
  """
  file(path: String!): EslintFile! @get {
    EslintFile(path: path, project: project)
  }

  """
  Lint the files in this collection with one ESLint run, and report every
  failing file. A plain helper, not a check: dagger check runs one check per
  file instead.
  """
  lint(ws: Workspace!): Void {
    if (paths.length > 0) {
      let summary = project.lintFiles(ws, paths, narrowed == false).summary
      if (summary != "") { raise summary }
    }
    null
  }
}

"""
A file ESLint lints.
"""
type EslintFile {
  """
  File path, relative to the workspace root.
  """
  path: String!

  let project: EslintProject!

  """
  Lint this file.
  """
  lint(ws: Workspace!, selection: EslintFiles!): Void @check {
    # selection is this project's file collection as dagger check filtered
    # it, the same for every file check in the project, so they all share
    # one ESLint run.
    project.lintFiles(ws, selection.paths, selection.narrowed == false).assertPassed(path)
  }
}

# One ESLint run's results, one bounded file per selected file, so a check
# reads only its own however large the report is.
type EslintResults {
  let paths: [String!]!

  # A failure shared by every file, found before ESLint ran, or "".
  let failure: String!

  # The indexer's output: file i holds the failure of paths[i], or nothing
  # when it passed, and "summary" every failure.
  let results: Directory!

  let assertPassed(path: String!): Void {
    # The rank is the file's position in the selection the indexer was given,
    # so file names never become result paths.
    let rank = paths.takeWhile { p => p != path }.length
    if (rank == paths.length) { raise path + ": outside the ESLint file selection" }
    if (failure != "") { raise failure }
    let result = results.file(toString(rank)).contents
    if (result != "") { raise result }
    null
  }

  let summary: String! {
    if (failure != "") { failure } else { results.file("summary").contents }
  }
}
